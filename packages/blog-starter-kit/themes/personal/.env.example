NEXT_PUBLIC_HASHNODE_GQL_ENDPOINT=https://gql.hashnode.com
NEXT_PUBLIC_HASHNODE_PUBLICATION_HOST=engineering.hashnode.com
NEXT_PUBLIC_MODE=development
NEXT_PUBLIC_ENABLE_SPEED_INSIGHTS=false
NEXT_PUBLIC_ENABLE_INTERVIEW_PREP=false
NEXT_PUBLIC_ENABLE_ASSISTANT=false
NEXT_PUBLIC_ENABLE_VISUALIZATION_LAB=false
NEXT_PUBLIC_ENABLE_ARTICLE_INTERACTIVE_TOOLS=false

# Public YouTube channel used by the Videos learning hub
YOUTUBE_CHANNEL_ID=UChQ6hLBvvloMv2IZPlHCdhw

# Firebase Configuration (for user authentication and progress tracking)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (for server-side operations)
# Get these from Firebase Console > Project Settings > Service Accounts > Generate new private key
# Preferred: store the complete JSON on the server in this single variable.
FIREBASE_SERVICE_ACCOUNT_KEY=
# Or provide the same credentials as separate variables:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
